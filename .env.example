# Copy to .env — never commit .env.

# PayPal SANDBOX app (developer.paypal.com → Apps & Credentials → Sandbox). Live is refused by the code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock = no PayPal calls (default when the id is empty); sandbox = real sandbox API
PAYPAL_MODE=sandbox
CURRENCY=USD

# Models. vertex = Gemini on Google Vertex AI (needs `gcloud auth application-default login`);
# mock = no model (demo and tests); bedrock = Amazon Nova via Strands (needs an AWS profile).
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_STRONG=gemini-2.5-pro
GEMINI_MID=gemini-2.5-flash
GEMINI_LIGHT=gemini-2.5-flash-lite

# Reward rules
CASHBACK_MAX=0.10
STEPS_GOAL=7000
