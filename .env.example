# Copy to .env — never commit .env.

# PayPal SANDBOX app (developer.paypal.com → Apps & Credentials → Sandbox). Live is refused by the code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock = no PayPal calls (default when the id is empty); sandbox = real sandbox API
PAYPAL_MODE=sandbox
CURRENCY=USD

# Models. vertex = Gemini on Google Vertex AI (needs `gcloud auth application-default login`);
# mock = no model (demo and tests); bedrock = Amazon Nova via Strands (needs an AWS profile).
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_STRONG=gemini-2.5-pro
GEMINI_MID=gemini-2.5-flash
GEMINI_LIGHT=gemini-3.1-flash-lite
# Retrieval over the public sources (the fact jurors read the passages closest to each claim)
GEMINI_EMBED=gemini-embedding-2
# Optional: a credentials file of its own, so this project's Google login does not replace the machine's default one
# GOOGLE_APPLICATION_CREDENTIALS=

# Reward rules
CASHBACK_MAX=0.20
STEPS_GOAL=7000
